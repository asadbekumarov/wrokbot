# Telegram API ma'lumotlari (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (@BotFather orqali olingan)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Sessiyalarni AES-256-GCM bilan shifrlash uchun 32-baytlik kalit (64 ta hex belgi)
# Generatsiya qilish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ixtiyoriy: HTTP port (AlwaysData yoki server monitoring uchun)
PORT=8080
